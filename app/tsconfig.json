{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@lib/*": ["lib/*"],
      "@ts-types/*": ["types/*"],
      "@components": ["components/index"],
      "@components/*": ["components/*"],
      "@containers": ["containers/index"],
      "@containers/*": ["containers/*"],
      "@styles/*": ["styles/*"],
      "@hooks/*": ["hooks/*"],
      "@hooks": ["hooks/index"],
      "@assets": ["assets/index"],
      "@proto/*": ["proto/*"],
      "@gRPC/*": ["gRPC/*"],
      "@gRPC": ["gRPC/index"]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../packages/dropgala-types/src/enums.ts"
  ],
  "exclude": ["node_modules"]
}

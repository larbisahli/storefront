{
  "name": "@dropgala/store",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build --watch",
    "build": "tsup src/* --format esm,cjs --dts --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "clean": "rm -rf dist && rm -rf .turbo"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "import": [
        "./dist/*.js",
        "./dist/*/index.js"
      ],
      "require": [
        "./dist/*.cjs",
        "./dist/*/index.cjs"
      ]
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*",
        "src/*/index"
      ]
    }
  },
  "publishConfig": {
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@dropgala/query": "workspace:*",
    "@dropgala/types": "workspace:*",
    "@dropgala/utils": "workspace:*",
    "@apollo/client": "^3.7.11",
    "react": "^17.0.0 || ^18.2.0-0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.3",
    "next-redux-wrapper": "^8.1.0",
    "nanoid": "^4.0.2"
  },
  "devDependencies": {
    "eslint": "^8.16.0",
    "@apollo/client": "^3.7.11",
    "@dropgala/query": "workspace:*",
    "eslint-config-dropgala": "workspace:*",
    "tsup": "^5.12.8",
    "typescript": "^4.5.5"
  }
}

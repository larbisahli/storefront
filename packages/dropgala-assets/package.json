{
  "name": "@dropgala/assets",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build:swc -w",
    "old-build": "rm -rf dist && pnpm build:swc && pnpm types",
    "build": "rm -rf dist && pnpm build:swc",
    "build:swc": "pnpm swc src -d dist",
    "types": "tsc --emitDeclarationOnly",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "clean": "rm -rf ./dist && rm -rf .turbo"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": [
      "./dist/*.js",
      "./dist/*/index.js"
    ],
    "./tailwind": {
      "require": "./dist/tailwind.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "src/*",
        "src/*/index"
      ],
      "tailwind": [
        "dist/tailwind.d.cts"
      ]
    }
  },
  "publishConfig": {
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "tailwind": [
          "dist/tailwind.d.cts"
        ]
      }
    }
  },
  "peerDependencies": {
    "@dropgala/types": "workspace:*",
    "react": "^18.2.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.3.10",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.31",
    "eslint": "^8.16.0",
    "eslint-config-dropgala": "workspace:*",
    "typescript": "4.8.4"
  }
}

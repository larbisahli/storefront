{
  "name": "@dropgala/luma",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build:swc -w",
    "old-build": "rm -rf dist && pnpm build:swc && pnpm types",
    "build": "rm -rf dist && pnpm build:swc",
    "build:swc": "pnpm copy-tailwind && swc src -d dist",
    "copy-tailwind": "mkdir -p dist && cp src/tailwind.cjs dist/tailwind.cjs",
    "types": "tsc --emitDeclarationOnly",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "clean": "rm -rf ./dist && rm -rf .turbo"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": [
      "./dist/*.js",
      "./dist/*/index.js"
    ],
    "./tailwind": {
      "require": "./dist/tailwind.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "src/*",
        "src/*/index"
      ],
      "tailwind": [
        "dist/tailwind.d.cts"
      ]
    }
  },
  "publishConfig": {
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "tailwind": [
          "dist/tailwind.d.cts"
        ]
      }
    }
  },
  "peerDependencies": {
    "clsx": "^1.1.1",
    "i18next": "^22.4.13",
    "next": "^13.2.4",
    "next-i18next": "^13.2.2",
    "react": "^17.0.0 || ^18.2.0-0",
    "react-dom": "^17.0.0 || ^18.2.0-0"
  },
  "dependencies": {
    "@dropgala/query": "workspace:*",
    "@dropgala/store": "workspace:*",
    "@dropgala/types": "workspace:*",
    "@dropgala/utils": "workspace:*",
    "@swc/helpers": "^0.4.12",
    "html-react-parser": "^3.0.16",
    "intersection-observer": "^0.12.2"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.3.10",
    "@types/react": "latest",
    "clsx": "^1.1.1",
    "eslint": "^8.16.0",
    "eslint-config-dropgala": "workspace:*",
    "i18next": "^22.4.13",
    "next": "^13.2.4",
    "next-i18next": "^13.2.2",
    "typescript": "4.8.4"
  }
}
